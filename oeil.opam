# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Terminal and MCP monitor for OCurrent pipelines"
description:
  "oeil reads the web UI of an OCurrent service, such as deploy.ci.ocaml.org, and shows its pipeline in a terminal or to an MCP client. Its main use is to follow a merged pull request until it is deployed."
maintainer: ["Cuihtlauac Alvarado <cuihtlauac@tarides.com>"]
authors: ["Cuihtlauac Alvarado <cuihtlauac@tarides.com>"]
license: "ISC"
homepage: "https://github.com/cuihtlauac/oeil"
bug-reports: "https://github.com/cuihtlauac/oeil/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.4"}
  "console" {>= "0.9.0"}
  "console-eio" {>= "0.9.0"}
  "eio_main" {>= "1.4"}
  "cohttp-eio" {>= "6.0"}
  "tls-eio" {>= "2.0"}
  "ca-certs"
  "mirage-crypto-rng"
  "xmlm"
  "yojson" {>= "2.0"}
  "cmdliner" {>= "1.3"}
  "uri"
  "ptime"
  "logs"
  "fmt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/cuihtlauac/oeil.git"
